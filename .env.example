# Public Firebase web configuration (safe to expose in the built client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set only for local development; production must omit it or use false.
VITE_FIREBASE_USE_EMULATORS=false

# Existing email delivery configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only: configure these in functions/.env, never in Vite.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# functions/.env: BIHR_USERNAME (customer code) and BIHR_PASSWORD (MacKey)
