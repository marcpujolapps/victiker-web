rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true; }
    match /catalog/{item} {
      allow read: if resource.data.status == 'active' || admin();
      allow create: if admin();
      allow update: if admin() && (resource.data.source != 'bihr' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']));
      allow delete: if admin();
    }
    match /taxonomies/{document=**} { allow read: if true; allow write: if admin(); }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /importJobs/{job} { allow read: if admin(); allow create, update, delete: if admin(); }
    match /bihrSyncJobs/{job} { allow read: if admin(); allow write: if false; }
    match /integrations/{integration} { allow read: if admin(); allow write: if false; }
    // Offer content is public only while active. Creation audit fields are immutable.
    // Required strings: title(1..120), description(0..280), imageUrl(0..2000),
    // imagePath(0..300), linkUrl(0..1000), linkLabel(0..40); active: bool;
    // order: int 0..9999; createdAt/updatedAt: timestamp; createdBy/updatedBy: uid.
    // Optional backgroundColor/textColor: six-digit hex colors; legacy offers remain editable.
    match /offers/{offerId} {
      allow read: if resource.data.active == true || admin();
      allow create: if admin() && validOffer()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() && validOffer()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if admin();
    }
    match /requests/{requestId} {
      allow create: if validRequestCreate();
      allow read: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updatedAt']) && validRequestAdminUpdate();
      allow delete: if admin();
    }

    function validOfferLink(value) {
      return value is string && value.size() <= 1000
        && !value.matches('.*[\\s\\\\].*')
        && (value == '' || value.matches('^/([^/].*)?$') || value.matches('^https?://[^/@]+(/.*|\\?.*|#.*)?$'));
    }

    function validOffer() {
      let data = request.resource.data;
      let fields = ['title', 'description', 'imageUrl', 'imagePath', 'linkUrl', 'linkLabel', 'active', 'order', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(['backgroundColor', 'textColor']))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 280
        && data.linkLabel is string && data.linkLabel.size() <= 40
        && validOfferLink(data.linkUrl)
        && data.imageUrl is string && data.imageUrl.size() <= 2000
        && data.imagePath is string && data.imagePath.size() <= 300
        && ((data.imageUrl == '' && data.imagePath == '')
          || (data.imageUrl.matches('^https?://[^/@]+/.*') && !data.imageUrl.matches('.*[\\s\\\\].*')
            && data.imagePath.matches('^offer-images/[A-Za-z0-9_-]{1,128}/[A-Za-z0-9-]+\\.webp$')))
        && data.active is bool
        && data.order is int && data.order >= 0 && data.order <= 9999
        && (!('backgroundColor' in data) || data.backgroundColor is string && data.backgroundColor.matches('^#[0-9a-fA-F]{6}$'))
        && (!('textColor' in data) || data.textColor is string && data.textColor.matches('^#[0-9a-fA-F]{6}$'))
        && data.createdAt is timestamp && data.updatedAt == request.time
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function validRequestCreate() {
      return request.resource.data.keys().hasOnly(['type', 'name', 'email', 'phone', 'vehicle', 'need', 'details', 'items', 'status', 'notes', 'createdAt', 'updatedAt'])
        && request.resource.data.type in ['parts', 'appointment']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 60
        && ((request.resource.data.type == 'parts' && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254 && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')) || (request.resource.data.type == 'appointment' && !('email' in request.resource.data)))
        && (!('vehicle' in request.resource.data) || request.resource.data.vehicle is string && request.resource.data.vehicle.size() <= 300)
        && (!('need' in request.resource.data) || request.resource.data.need is string && request.resource.data.need.size() <= 160)
        && (!('details' in request.resource.data) || request.resource.data.details is string && request.resource.data.details.size() <= 2000)
        && (!('items' in request.resource.data) || request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50)
        && request.resource.data.status == 'new'
        && request.resource.data.notes == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.type == 'parts' && 'items' in request.resource.data) || (request.resource.data.type == 'appointment' && 'need' in request.resource.data));
    }

    function validRequestAdminUpdate() {
      return request.resource.data.notes is string && request.resource.data.notes.size() <= 5000
        && request.resource.data.updatedAt == request.time;
    }
  }
}
